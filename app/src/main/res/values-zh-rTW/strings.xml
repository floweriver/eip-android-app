    <!-- Flip 鍵盤首次使用教學 -->
    <string name="flip_tutorial_help">查看教學</string>
    <string name="flip_tutorial_close">關閉</string>
    <string name="flip_tutorial_skip">略過</string>
    <string name="flip_tutorial_previous">上一步</string>
    <string name="flip_tutorial_next">下一步</string>
    <string name="flip_tutorial_done">開始使用</string>
    <string name="flip_tutorial_page1_title">認識你的鍵盤</string>
    <string name="flip_tutorial_page1_description">F1–F3：三顆自訂快捷鍵\nF4：藍牙配對\nF10–F12：切換裝置 1–3\n側邊開關撥到開啟才能使用，旁邊是 USB-C 充電孔\n充電線接在鍵盤背面，接線時也能直接使用</string>
    <string name="flip_tutorial_page2_title">依裝置系統切換模式</string>
    <string name="flip_tutorial_page2_description">每台裝置都要選對系統，快捷鍵才正確\nAndroid 手機、平板請選 Android（Samsung Galaxy 選 Samsung）\n在 App 選好系統，鍵盤會自動套用\n鍵盤上也可按 Fn + E（iOS）/ Q（Android）/ W（Windows）/ S（Samsung）</string>
    <string name="flip_tutorial_page3_title">Type-C 有線連接</string>
    <string name="flip_tutorial_page3_description">接上 USB-C 線並開機即可使用，同時為鍵盤充電\n此時若為鍵盤充電，也可以同時幫您的裝置充電\n接線模式固定為複製、貼上、全選\n若要使用其他自訂快捷鍵，請改用藍牙連接鍵盤來設定和使用</string>
    <string name="flip_tutorial_page4_title">設定快捷鍵</string>
    <string name="flip_tutorial_page4_description">展開裝置，每顆鍵先選平臺、再選功能\n選好會自動寫入鍵盤\n按「重設」回到複製、貼上、全選</string>
    <string name="flip_tutorial_page5_title">設定休眠時間</string>
    <string name="flip_tutorial_page5_description">拖曳滑桿，1–15 分鐘無操作自動休眠\n按任意鍵即喚醒\n三台裝置共用此設定</string>
    <string name="flip_language_system">跟隨系統</string>
