    <!-- 首次使用教學 -->
    <string name="flip_tutorial_help">チュートリアルを見る</string>
    <string name="flip_tutorial_close">閉じる</string>
    <string name="flip_tutorial_skip">スキップ</string>
    <string name="flip_tutorial_previous">戻る</string>
